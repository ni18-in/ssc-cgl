{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssc-cgl-prep.local/schemas/formula-sheet.schema.json",
  "title": "Formula sheet",
  "description": "Searchable formula and shortcut cards, grouped by topic. Rendered with flutter_math_fork when 'latex' is present, otherwise as plain text.",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sheetId": { "$ref": "common.schema.json#/$defs/slug" },
    "subject": { "$ref": "common.schema.json#/$defs/subject" },
    "title": { "$ref": "common.schema.json#/$defs/localizedText" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "required": ["schemaVersion", "sheetId", "subject", "title", "groups"],
  "additionalProperties": false,

  "$defs": {
    "group": {
      "type": "object",
      "properties": {
        "topic": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "$ref": "common.schema.json#/$defs/localizedText" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        }
      },
      "required": ["topic", "title", "cards"],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^f_[a-z0-9_]+_\\d{4}$" },
        "label": { "$ref": "common.schema.json#/$defs/localizedText" },
        "latex": {
          "type": ["string", "null"],
          "description": "TeX body without delimiters. null for prose-only shortcut cards."
        },
        "plain": {
          "type": "string",
          "description": "Plain-text form. Always required — it is what the copy button copies and what search indexes."
        },
        "note": { "anyOf": [{ "$ref": "common.schema.json#/$defs/localizedText" }, { "type": "null" }] },
        "kind": {
          "type": "string",
          "enum": ["formula", "shortcut", "identity", "conversion"]
        }
      },
      "required": ["id", "label", "plain", "kind"],
      "additionalProperties": false
    }
  }
}
